# Compose requires DATATUG_IMAGE. Build a source-free context first and use
# its local image tag. Change DATATUG_LOCAL_OWNER only after reviewing the
# local-owner behavior documented in docs/docker.md.
DATATUG_IMAGE=datatug-cli:local
DATATUG_LOCAL_OWNER=false
DATATUG_TELEMETRY=0

# Fill these only in a private distribution/.env copy. Tokens must be at least
# 32 characters and must be distinct. Never commit the populated file.
DATATUG_COORDINATOR_DB_URL=sqlite:///var/lib/datatug/coordinator/watch.sqlite
DATATUG_WATCH_ALICE_TOKEN=
DATATUG_WATCH_RUNNER_TOKEN=
